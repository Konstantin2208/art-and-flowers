---
import GalleryGrid from '../components/GalleryGrid.astro';
import Layout from '../layouts/Layout.astro';

const glass =
	'flex h-full flex-col justify-between bg-white/5 backdrop-blur-md border border-[#FBEDFF]/15 rounded-3xl p-6 shadow-xl hover:border-[#FBEDFF]/40 transition-all duration-300';

const services = [
	{
		name: 'Сватбена украса',
		image: '/images/minimalistic.JPG',
		alt: 'Сватбена флорална украса и церемониална арка - Art & Flowers Пловдив',
		copy: 'Булчински букети, арки за изнесен брак, украса на маси, бутониери и цветни аранжировки за автомобил.',
	},
	{
		name: 'Корпоративни събития',
		image: '/images/elegans.JPG',
		alt: 'Стилна флорална декорация за корпоративно събитие - Art & Flowers Пловдив',
		copy: 'Стилна декорация за брандинг събития, гала вечери, откриване на обекти и официални вечери.',
	},
	{
		name: 'Лични празници',
		image: '/images/premium.jpg',
		alt: 'Тематична цветна украса за личен празник - Art & Flowers Пловдив',
		copy: 'Тематична украса от цветя за юбилей, кръщене, моминско парти и специални изненади.',
	},
];

const items = [
	{
		title: 'Церемониална арка',
		copy: 'Флорална арка за изнесен брак, кръщене и фотосесия — индивидуален проект според палитрата на събитието.',
		alt: 'Церемониална арка с цветя и балони - Art & Flowers Пловдив',
		image: '/images/20240909_130709.jpg',
	},
	{
		title: 'Вечерна трапеза',
		copy: 'Елегантни центрове за маси със свещи и сезонни цветя за сватбена вечеря и гала прием.',
		alt: 'Вечерна маса със свещи и флорални центрове - Art & Flowers Пловдив',
		image: '/images/41CE0A7E-283E-4045-BEA9-5D33E0BDEAAE.JPG',
	},
	{
		title: 'Приемна маса',
		copy: 'Гирлянди от бели рози и евкалипт за сватбена трапеза и официална декорация в Пловдив.',
		alt: 'Сватбена трапеза с гирлянд от бели рози и евкалипт - Art & Flowers Пловдив',
		image: '/images/IMG-5679cd219c6d3323c7dcc10f4653f572-V.jpg',
	},
	{
		title: 'Балонна гирлянда',
		copy: 'Розова балонна гирлянда и цветна украса за рожден ден и моминско парти.',
		alt: 'Розова балонна гирлянда за рожден ден - Art & Flowers Пловдив',
		image: '/images/20240713_121232.jpg',
	},
	{
		title: 'Златна инсталация',
		copy: 'Премиум инсталация с бели и златни балони за тържествен вход и фото зона.',
		alt: 'Балонна инсталация с бели и златни балони - Art & Flowers Пловдив',
		image: '/images/20241116_110416.jpg',
	},
	{
		title: 'Тематична украса',
		copy: 'Цялостна концепция за кръщене и детски празник с цветя, балони и сладка маса.',
		alt: 'Тематична украса за кръщене - Art & Flowers Пловдив',
		image: '/images/20231111_111629.jpg',
	},
];
---

<Layout
	title="Сватбена украса и декориране на събития Пловдив – Art & Flowers"
	description="Цялостна сватбена флористика, арки от цветя, декорация за рождени дни и корпоративни събития в Пловдив. Направете запитване за индивидуален проект."
>
	<section class="relative px-4 pt-24 pb-10 text-center sm:px-6 md:px-8 md:pt-32 md:pb-14">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div
				class="absolute top-20 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-[#FBEDFF]/15 blur-3xl"
			>
			</div>
		</div>
		<h1 class="font-serif text-2xl font-medium tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl">
			Сватбена флористика &amp; Декорация за събития
		</h1>
		<p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed font-light text-white/95 sm:text-lg">
			Превръщаме Вашето събитие в незабравима приказка. Проектираме и изграждаме цялостни флорални концепции за сватби, корпоративни партита, лични празници и фотосесии в Пловдив и региона.
		</p>
	</section>

	<section id="packages" class="mx-auto max-w-6xl px-4 py-8 sm:px-6 md:px-8 sm:py-12">
		<div class="mb-14 text-center">
			<h2 class="font-serif mt-3 text-2xl font-medium tracking-tight sm:text-4xl md:text-5xl">
				Услуги за събития
			</h2>
		</div>

		<div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-8 lg:grid-cols-3">
			{
				services.map((svc) => (
					<article class={glass}>
						<div class="flex flex-grow flex-col">
							<div class="overflow-hidden">
								<img
									src={svc.image}
									alt={svc.alt}
									width="900"
									height="675"
									loading="lazy"
									class="aspect-[4/3] w-full rounded-t-[30px] object-cover md:rounded-t-[40px]"
								/>
							</div>
							<h3 class="font-serif mt-5 text-2xl text-white">{svc.name}</h3>
							<p class="mt-4 flex-grow text-sm leading-relaxed font-light text-white/90">{svc.copy}</p>
						</div>
						<a
							href="/#inquiry-form"
							class="js-inquiry-btn btn mt-auto w-full"
						>
							Запитване 
						</a>
					</article>
				))
			}
		</div>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-28 sm:px-6 md:px-8 md:pb-24">
		<h2 class="mb-10 text-center font-serif text-2xl font-medium tracking-tight sm:text-4xl">
			Реализирани проекти
		</h2>
		<GalleryGrid items={items} />
	</section>
</Layout>
