---
import GalleryGrid from '../components/GalleryGrid.astro';
import Layout from '../layouts/Layout.astro';

const items = [
	{
		title: 'Кошница с цветя',
		copy: 'Бяла плетена кошница с рози, еустома, карамфили и гипсофила.',
		alt: 'Цветна кошница с бели рози, еустома и гипсофила - Art & Flowers',
		image: '/images/IMG_0181.JPG',
	},
	{
		title: 'Кутия с рози',
		copy: 'Розова кутия с цикламени рози — за подарък и изненада.',
		alt: 'Цветна кутия с цикламени рози и подаръци - Art & Flowers',
		image: '/images/IMG_0182.JPG',
	},
	{
		title: 'Кутия с хризантеми',
		copy: 'Лилава кутия Art & Flowers с жълти хризантеми и гипсофила.',
		alt: 'Цветна кутия с жълти хризантеми и панделка - Art & Flowers',
		image: '/images/IMG_0183.JPG',
	},
	{
		title: 'Кутия с инициали',
		copy: 'Персонализирана кръгла кутия — за сватба, годишнина или изненада.',
		alt: 'Персонализирана бяла цветна кутия с инициали - Art & Flowers',
		image: '/images/temp_image_97463196-F7A6-4D26-BC34-C64998B41B47.jpeg',
	},
	{
		title: 'Център за маса',
		copy: 'Ниска композиция с гербери, карамфили и зеленина за трапезата.',
		alt: 'Аранжировка за маса с гербери, карамфили и свещи - Art & Flowers',
		image: '/images/468E428B-96F8-4E71-BCA1-C497F127A7FA.JPG',
	},
	{
		title: 'Гирлянд за трапеза',
		copy: 'Бели рози, евкалипт и гипсофила по дължината на масата.',
		alt: 'Флорален гирлянд с бели рози, евкалипт и гипсофила - Art & Flowers',
		image: '/images/IMG-07cd875c6aeb181f3f94389445e7d119-V.jpg',
	},
];
---

<Layout
	title="Флорални аранжировки — Art & Flowers"
	description="Флорални кутии, съдове и дълготрайни композиции за масата и дома."
>
	<section class="relative px-4 pt-24 pb-10 text-center sm:px-6 md:px-8 md:pt-32 md:pb-14">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div
				class="absolute top-20 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-[#FBEDFF]/15 blur-3xl"
			>
			</div>
		</div>
		<h1 class="font-serif text-2xl font-medium tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl">
			Флорални аранжировки &amp; Кутии
		</h1>
		<p class="mx-auto mt-8 max-w-lg text-base leading-relaxed font-light text-white/95 sm:text-lg">
			Кутии, керамика, стъкло и дълготрайна флорална арт за масата и дома.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-28 sm:px-6 md:px-8 md:pb-24">
		<GalleryGrid items={items} />
	</section>
</Layout>
