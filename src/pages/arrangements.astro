---
import GalleryGrid from '../components/GalleryGrid.astro';
import Layout from '../layouts/Layout.astro';

const items = [
	{
		title: 'Аристократична кошница',
		copy: 'Луксозна плетена кошница с рози, еустома и гипсофила — елегантна аранжировка за дома и изискан подарък в Пловдив.',
		alt: 'Луксозна цветна кошница с рози, еустома и гипсофила - Art & Flowers Пловдив',
		image: '/images/IMG_0181.JPG',
	},
	{
		title: 'Розова магия в кутия',
		copy: 'Стилна дизайнерска кутия с цикламени рози — цветя в кутия без нужда от ваза, идеални за изненада и романтичен жест.',
		alt: 'Луксозни цветя в кутия с цикламени рози - Art & Flowers Пловдив',
		image: '/images/IMG_0182.JPG',
	},
	{
		title: 'Слънчева кутия',
		copy: 'Бутикова кутия Art & Flowers с жълти хризантеми и гипсофила — дълготрайна красота и ярък акцент за масата.',
		alt: 'Цветя в кутия с жълти хризантеми - Art & Flowers Пловдив',
		image: '/images/IMG_0183.JPG',
	},
	{
		title: 'Персонална кутия с инициали',
		copy: 'Кръгла луксозна кутия с монограм — цветя по поръчка за сватба, годишнина и бутиков подарък.',
		alt: 'Персонализирана цветна кутия с инициали - Art & Flowers Пловдив',
		image: '/images/temp_image_97463196-F7A6-4D26-BC34-C64998B41B47.jpeg',
	},
	{
		title: 'Център за маса',
		copy: 'Ниска композиция с гербери и зеленина в елегантен съд — практична аранжировка за трапеза и събитие.',
		alt: 'Флорална аранжировка за маса с гербери - Art & Flowers Пловдив',
		image: '/images/468E428B-96F8-4E71-BCA1-C497F127A7FA.JPG',
	},
	{
		title: 'Гирлянд за трапеза',
		copy: 'Бяли рози, евкалипт и гипсофила по дължината на масата — луксозна флорална линия за сватба и гала вечеря.',
		alt: 'Флорален гирлянд с бели рози и евкалипт - Art & Flowers Пловдив',
		image: '/images/IMG-07cd875c6aeb181f3f94389445e7d119-V.jpg',
	},
];
---

<Layout
	title="Цветя в кутия и луксозни аранжировки Пловдив – Art & Flowers"
	description="Стилни аранжировки от цветя в кутии, кошници и елегантни съдове. Дълготрайна красота и бутиков дизайн от Art & Flowers Пловдив."
>
	<section class="relative px-3 pt-24 pb-10 text-center sm:px-4 lg:px-5 md:pt-32 md:pb-14">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div
				class="absolute top-20 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-[#FBEDFF]/15 blur-3xl"
			>
			</div>
		</div>
		<h1 class="font-serif text-2xl font-medium tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl">
			Луксозни цветя в кутия &amp; Аранжировки
		</h1>
		<p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed font-light text-white/95 sm:text-lg">
			Изискани композиции в дизайнерски кутии, кошници и съдове. Практично и дълготрайно решение, което запазва своята свежест без нужда от ваза.
		</p>
	</section>

	<section class="mx-auto max-w-7xl px-3 pb-28 sm:px-4 lg:px-5 md:pb-24">
		<h2 class="sr-only">Колекция цветя в кутия и аранжировки</h2>
		<GalleryGrid items={items} />
	</section>
</Layout>
