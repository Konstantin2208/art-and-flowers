---
import GalleryGrid from '../components/GalleryGrid.astro';
import Layout from '../layouts/Layout.astro';

const items = [
	{
		title: 'Кралска елегантност',
		copy: 'Авторски букет от премиум червени рози в стилна опаковка — класика за рожден ден, годишнина и специално признание в Пловдив.',
		alt: 'Авторски букет от червени рози в крафт хартия - Art & Flowers Пловдив',
		image: '/images/IMG_9847.jpeg',
	},
	{
		title: 'Кадифено сияние',
		copy: 'Бутиков букет със синя гипсофила и мека текстура — уникална флористика за изискан подарък и вечерна изненада.',
		alt: 'Авторски букет от синя гипсофила в светлосиня хартия - Art & Flowers Пловдив',
		image: '/images/IMG_0138.jpeg',
	},
	{
		title: 'Пролетна симфония',
		copy: 'Хармония от слънчогледи, хризантеми и евкалипт — сезонни цветя с бутиков характер за светъл и радостен повод.',
		alt: 'Авторски букет от слънчогледи, хризантеми и евкалипт - Art & Flowers Пловдив',
		image: '/images/IMG_0106.jpeg',
	},
	{
		title: 'Облак от нежност',
		copy: 'Пищен облак от бяла гипсофила в розова опаковка — лек, романтичен авторски букет за всеки специален момент.',
		alt: 'Голям авторски букет от бяла гипсофила в розова хартия - Art & Flowers Пловдив',
		image: '/images/IMG_8032.JPG',
	},
	{
		title: 'Бяла поезия',
		copy: 'Изискани бели еустоми и гипсофила с дантелена панделка — бутикова флористика за сватба, кръщене и тържествен жест.',
		alt: 'Авторски букет от бели еустоми и гипсофила - Art & Flowers Пловдив',
		image: '/images/IMG_9720.jpeg',
	},
	{
		title: 'Слънчева градина',
		copy: 'Дизайнерски микс от бели, жълти и оранжеви рози със зеленина — топли цветове и текстури за празнична изненада.',
		alt: 'Авторски букет от бели, жълти и оранжеви рози - Art & Flowers Пловдив',
		image: '/images/Gemini_Generated_Image_fvuv5qfvuv5qfvuv.jpg',
	},
	{
		title: 'Кремава хармония',
		copy: 'Нежни кремави рози и гипсофила — елегантен авторски букет с дълготрайна свежест и тих лукс.',
		alt: 'Авторски букет от кремави рози и гипсофила - Art & Flowers Пловдив',
		image: '/images/Gemini_Generated_Image_2pkm22pkm22pkm22.jpg',
	},
	{
		title: 'Перлена калия',
		copy: 'Сватбен букет от бели калии, рози и перли — майсторска флористика за булката и изнесен брак в Пловдив.',
		alt: 'Сватбен авторски букет от бели калии, рози и перли - Art & Flowers Пловдив',
		image: '/images/IMG_0007.JPG',
	},
	{
		title: 'Бутикови божури',
		copy: 'Сезонни бели божури с дантелена панделка — премиум цветя по поръчка за романтичен и незабравим подарък.',
		alt: 'Авторски букет от бели божури с дантелена панделка - Art & Flowers Пловдив',
		image: '/images/IMG_0016.JPG',
	},
];
---

<Layout
	title="Авторски букети Пловдив | Бутикови цветя по поръчка – Art & Flowers"
	description="Уникални авторски букети с пресни сезонни и екзотични цветя в Пловдив. Стилна опаковка и майсторска флористика за всеки специален повод."
>
	<section class="relative px-3 pt-24 pb-10 text-center sm:px-4 lg:px-5 md:pt-32 md:pb-14">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div
				class="absolute top-20 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-[#FBEDFF]/15 blur-3xl"
			>
			</div>
		</div>
		<h1 class="font-serif text-2xl font-medium tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl">
			Авторски букети с бутиков характер
		</h1>
		<p class="mx-auto mt-8 max-w-3xl text-base leading-relaxed font-light text-white/95 sm:text-lg">
			Открийте нашата колекция от дизайнерски букети, съчетаващи хармония от цветове, текстури и аромати. Всеки букет се изработва по индивидуално запитване според Вашите предпочитания.
		</p>
	</section>

	<section class="mx-auto max-w-7xl px-3 pb-28 sm:px-4 lg:px-5 md:pb-24">
		<h2 class="sr-only">Колекция авторски букети</h2>
		<GalleryGrid items={items} />
	</section>
</Layout>
