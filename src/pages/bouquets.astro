---
import GalleryGrid from '../components/GalleryGrid.astro';
import Layout from '../layouts/Layout.astro';

const items = [
	{
		title: 'Червени рози',
		alt: 'Букет от червени рози в крафт хартия - Art & Flowers',
		image: '/images/IMG_9847.jpeg',
	},
	{
		title: 'Синя гипсофила',
		alt: 'Букет от синя гипсофила в светлосиня хартия - Art & Flowers',
		image: '/images/IMG_0138.jpeg',
	},
	{
		title: 'Слънчогледи',
		alt: 'Букет от слънчогледи, хризантеми, хортензия и евкалипт - Art & Flowers',
		image: '/images/IMG_0106.jpeg',
	},
	{
		title: 'Облак от гипсофила',
		alt: 'Голям букет от бяла гипсофила в розова хартия - Art & Flowers',
		image: '/images/IMG_8032.JPG',
	},
	{
		title: 'Бели еустоми',
		alt: 'Букет от бели еустоми и гипсофила с дантелена панделка - Art & Flowers',
		image: '/images/IMG_9720.jpeg',
	},
	{
		title: 'Слънчева градина',
		alt: 'Букет от бели, жълти и оранжеви рози със зеленина - Art & Flowers',
		image: '/images/Gemini_Generated_Image_fvuv5qfvuv5qfvuv.jpg',
	},
	{
		title: 'Кремави рози',
		alt: 'Букет от кремави рози и гипсофила - Art & Flowers',
		image: '/images/Gemini_Generated_Image_2pkm22pkm22pkm22.jpg',
	},
	{
		title: 'Бели калии',
		alt: 'Сватбен букет от бели калии, рози и перли - Art & Flowers',
		image: '/images/IMG_0007.JPG',
	},
	{
		title: 'Бели божури',
		alt: 'Букет от бели божури с дантелена панделка - Art & Flowers',
		image: '/images/IMG_0016.JPG',
	},
];
---

<Layout
	title="Авторски букети — Art & Flowers"
	description="Ръчно вързани букети от сезонни цветя за подарък, празник и всекидневна красота."
>
	<section class="relative px-4 pt-24 pb-10 text-center sm:px-6 md:px-8 md:pt-32 md:pb-14">
		<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
			<div
				class="absolute top-20 left-1/2 h-56 w-56 -translate-x-1/2 rounded-full bg-[#FBEDFF]/15 blur-3xl"
			>
			</div>
		</div>
		<h1 class="font-serif text-2xl font-medium tracking-tight text-balance sm:text-4xl md:text-5xl lg:text-6xl">
			Авторски букети
		</h1>
		
		<p class="mx-auto mt-8 max-w-lg text-base leading-relaxed font-light text-white/95 sm:text-lg">
			Събрани на ръка — диви, с панделка или каскадни. Всеки букет се прави сутринта, в която
			напуска студиото.
		</p>
	</section>

	<section class="mx-auto max-w-6xl px-4 pb-28 sm:px-6 md:px-8 md:pb-24">
		<GalleryGrid items={items} />
	</section>
</Layout>
