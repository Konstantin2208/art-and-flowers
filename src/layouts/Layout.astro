---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Елегантни авторски букети, луксозни цветя в кутия и цялостна сватбена украса в Пловдив. Индивидуален дизайн и бързо запитване за цена през Viber или онлайн.',
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
	{ href: '/', label: 'Начало' },
	{ href: '/bouquets', label: 'Букети' },
	{ href: '/events', label: 'Украса за събития' },
	{ href: '/arrangements', label: 'Аранжировки' },
];

const viberHref = 'viber://chat?number=%2B359876997754';
const instagramHref = 'https://www.instagram.com/artn.flowers';
const facebookHref = 'https://www.facebook.com/p/ArtFlowers-61572676835992/';
---

<!doctype html>
<html lang="bg" class="overflow-x-hidden scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Source+Sans+3:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body class="min-h-screen overflow-x-hidden bg-[#503270] font-sans text-white antialiased">
		<div
			class="pointer-events-none fixed inset-0 z-0 bg-center bg-no-repeat bg-[length:min(90vw,28rem)] opacity-10 md:bg-[length:30%]"
			style="background-image: url('/ralica (1).png');"
			aria-hidden="true"
		>
		</div>

		<header class="absolute inset-x-0 top-0 z-40 overflow-x-hidden">
			<nav
				class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 pt-4 sm:px-6 lg:px-8"
				aria-label="Основна навигация"
			>
				<div
					class="flex w-full items-center justify-between gap-3 rounded-full border border-[#FBEDFF]/15 bg-white/5 px-4 py-3 shadow-2xl backdrop-blur-md sm:px-6 sm:py-3.5"
				>
					<a href="/" class="flex shrink-0 items-center" aria-label="Art & Flowers">
						<img
							src="/logo-full.png"
							alt="Art & Flowers"
							class="h-12 w-auto object-contain transition-all sm:h-14 md:h-16"
							onerror="this.onerror=null; this.src='/logo-full.svg'; this.style.filter='brightness(0) invert(1)';"
						/>
					</a>

					<div class="hidden items-center gap-6 font-sans text-sm font-semibold normal-case tracking-normal md:flex md:gap-8">
						{
							nav.map((item) => {
								const active = path === item.href;
								return (
									<a
										href={item.href}
										aria-current={active ? 'page' : undefined}
										class:list={[
											'whitespace-nowrap transition-opacity hover:opacity-70',
											active && 'text-[#FBEDFF] underline decoration-[#FBEDFF] underline-offset-8',
										]}
									>
										{item.label}
									</a>
								);
							})
						}
					</div>

					<button
						type="button"
						id="nav-toggle"
						class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-[#FBEDFF]/30 text-[#FBEDFF] md:hidden"
						aria-expanded="false"
						aria-controls="mobile-nav"
						aria-label="Отвори меню"
					>
						<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
					</button>
				</div>
			</nav>

			<div
				id="mobile-nav"
				class="mt-3 hidden border-b border-[#FBEDFF]/20 bg-[#503270] p-6 text-center md:hidden"
			>
				<div class="flex flex-col gap-4">
					{
						nav.map((item) => {
							const active = path === item.href;
							return (
								<a
									href={item.href}
									aria-current={active ? 'page' : undefined}
									class:list={[
										'inline-flex min-h-11 items-center justify-center font-sans text-sm font-semibold normal-case tracking-normal',
										active ? 'text-[#FBEDFF]' : 'text-white',
									]}
								>
									{item.label}
								</a>
							);
						})
					}
				</div>
			</div>
		</header>

		<main class="relative z-10 overflow-x-hidden">
			<slot />
		</main>

		<div class="fixed right-6 bottom-6 z-50 flex flex-col items-center gap-3">
			<a
				href={instagramHref}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Instagram"
				class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-tr from-yellow-500 via-pink-500 to-purple-600 text-white shadow-lg transition-all hover:scale-110"
			>
				<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm10 1.8H7A3.2 3.2 0 0 0 3.8 7v10A3.2 3.2 0 0 0 7 20.2h10A3.2 3.2 0 0 0 20.2 17V7A3.2 3.2 0 0 0 17 3.8zM12 7.2A4.8 4.8 0 1 1 7.2 12 4.8 4.8 0 0 1 12 7.2zm0 1.8A3 3 0 1 0 15 12a3 3 0 0 0-3-3zm5.35-3.15a1.15 1.15 0 1 1-1.15 1.15 1.15 1.15 0 0 1 1.15-1.15z"
					></path>
				</svg>
			</a>
			<a
				href={facebookHref}
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Facebook"
				class="flex h-12 w-12 items-center justify-center rounded-full bg-[#1877F2] text-white shadow-lg transition-all hover:scale-110"
			>
				<svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M14 9h3V6h-3c-2.2 0-4 1.8-4 4v2H8v3h2v7h3v-7h2.6l.4-3H13v-2c0-.6.4-1 1-1z"
					></path>
				</svg>
			</a>
			<a
				href={viberHref}
				aria-label="Пишете ни във Viber"
				class="flex h-12 w-12 items-center justify-center rounded-full bg-[#7360F2] text-white shadow-2xl transition-all hover:scale-110 md:h-14 md:w-14"
			>
				<svg class="h-6 w-6 md:h-7 md:w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path
						d="M12 2C6.5 2 2 6.1 2 11.2c0 2.6 1.1 4.9 3 6.6V22l3.3-1.8c1.1.3 2.4.5 3.7.5 5.5 0 10-4.1 10-9.5S17.5 2 12 2zm4.8 13.3c-.2.5-1 .9-1.6 1-1.3.2-2.6-.3-3.6-.9-2.2-1.3-3.6-3.5-3.8-3.8-.2-.3-1.5-2-1.5-3.8s.9-2.7 1.3-3.1c.3-.3.8-.4 1.1-.4h.8c.3 0 .6 0 .8.6.3.8 1 2.7 1.1 2.9.1.2.1.5 0 .7-.1.3-.2.4-.4.7-.2.2-.4.5-.2.9.2.4.9 1.5 1.9 2.4 1.3 1.1 2.4 1.5 2.8 1.7.3.1.6.1.8-.1.2-.3.9-1 .9-1.1.2-.2.4-.2.7-.1.3.1 2 .9 2.3 1.1.3.2.5.3.6.4.1.3 0 .8-.2 1.3z"
					></path>
				</svg>
			</a>
		</div>

		<div class="pointer-events-none relative z-10 leading-[0]" aria-hidden="true">
			<svg viewBox="0 0 1440 72" class="w-full" preserveAspectRatio="none">
				<path
					fill="currentColor"
					class="text-[#FBEDFF]/5"
					d="M0,32 C240,72 480,8 720,40 C960,72 1200,16 1440,48 L1440,72 L0,72 Z"></path>
			</svg>
		</div>

		<footer class="relative z-10 pb-28 md:pb-24">
			<div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
				<div
					class="rounded-3xl border border-[#FBEDFF]/15 bg-white/5 p-6 shadow-xl backdrop-blur-md sm:p-10"
				>
					<div class="mb-10 max-w-xl">
						<p class="font-serif text-2xl">Art &amp; Flowers</p>
						<p class="mt-3 font-light text-[#FBEDFF]">Бутиков магазин за цветя и сватбена флористика в Пловдив.</p>
					</div>
					<address
						class="not-italic grid grid-cols-1 gap-8 text-sm leading-relaxed font-light sm:grid-cols-2 sm:text-base lg:grid-cols-4"
					>
						<p>
							<span class="mb-1 block text-[0.7rem] tracking-[0.2em] text-[#FBEDFF] uppercase"
								>Адрес</span
							>
							бул. Освобождение №93, гр. Пловдив
						</p>
						<p>
							<span class="mb-1 block text-[0.7rem] tracking-[0.2em] text-[#FBEDFF] uppercase"
								>Телефони</span
							>
							<a href="tel:+359877001225" class="inline-flex min-h-11 items-center transition-opacity hover:opacity-70"
								>0877001225</a
							>
							{' / '}
							<a href="tel:+359876997754" class="inline-flex min-h-11 items-center transition-opacity hover:opacity-70"
								>0876997754</a
							>
						</p>
						<p>
							<span class="mb-1 block text-[0.7rem] tracking-[0.2em] text-[#FBEDFF] uppercase"
								>Имейл</span
							>
							<a
								href="mailto:artnflowers25@gmail.com"
								class="inline-flex min-h-11 items-center break-all transition-opacity hover:opacity-70"
								>artnflowers25@gmail.com</a
							>
						</p>
						<div>
							<span class="mb-1 block text-[0.7rem] tracking-[0.2em] text-[#FBEDFF] uppercase"
								>Работно време</span
							>
							<p>Понеделник - Петък: 10:00 - 19:00</p>
							<p class="mt-1">Събота: 10:00 - 15:00</p>
						</div>
					</address>
				</div>
			</div>
		</footer>

		<script>
			const toggle = document.getElementById('nav-toggle');
			const panel = document.getElementById('mobile-nav');
			if (toggle && panel) {
				const setOpen = (open: boolean) => {
					panel.classList.toggle('hidden', !open);
					toggle.setAttribute('aria-expanded', String(open));
					toggle.setAttribute('aria-label', open ? 'Затвори меню' : 'Отвори меню');
				};
				toggle.addEventListener('click', () => {
					setOpen(panel.classList.contains('hidden'));
				});
				window.addEventListener('resize', () => {
					if (window.matchMedia('(min-width: 768px)').matches) setOpen(false);
				});
			}

			const goToInquiryForm = () => {
				if (window.location.pathname === '/') {
					const form = document.getElementById('inquiry-form');
					if (form) {
						form.scrollIntoView({ behavior: 'smooth' });
					} else {
						window.location.href = '/#inquiry-form';
					}
				} else {
					window.location.href = '/#inquiry-form';
				}
			};

			const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(
				navigator.userAgent,
			);

			document.querySelectorAll('.js-inquiry-btn').forEach((button) => {
				button.addEventListener('click', (e) => {
					if (isMobile) {
						e.preventDefault();
						const start = Date.now();
						window.location.href = 'viber://chat?number=%2B359876997754';

						setTimeout(() => {
							if (Date.now() - start < 1500) {
								goToInquiryForm();
							}
						}, 1000);
					} else {
						e.preventDefault();
						goToInquiryForm();
					}
				});
			});
		</script>
	</body>
</html>
